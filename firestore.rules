rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // fonction helper pour verifier si user est admin
    function isAdmin(userId) {
      let userData = get(/databases/$(database)/documents/users/$(userId)).data;
      return userData != null && userData.get('role', 'user') == 'admin';
    }

    // helper pour verifier si user est banni
    function isBanned(userId) {
      let userData = get(/databases/$(database)/documents/users/$(userId)).data;
      return userData != null && userData.get('status', 'active') == 'banned';
    }
    
    // Règles pour les utilisateurs
    match /users/{userId} {
      allow read: if request.auth != null;
      
      // write : user lui-meme (sans modif role) OU admin
      allow write: if request.auth != null && (
        (
          request.auth.uid == userId
          && !('role' in request.resource.data.diff(resource.data).affectedKeys())
        )
        || isAdmin(request.auth.uid)
      );
      
      // Règles pour les push tokens
      match /pushTokens/{tokenId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId
          && !isBanned(request.auth.uid);
      }
      
      // Règles pour les notifications
      match /notifications/{notifId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId
          && !isBanned(request.auth.uid);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Règles pour les activités
    match /activities/{activityId} {
      // Lecture : tout utilisateur authentifié
      allow read: if request.auth != null;
      
      // Création : tout utilisateur authentifié
      allow create: if request.auth != null
        && !isBanned(request.auth.uid)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.date is timestamp;
      
      // Mise à jour : uniquement le créateur ou pour ajouter/retirer des participants
      allow update: if request.auth != null && (
        // Le créateur peut tout modifier
        (resource.data.ownerId == request.auth.uid && !isBanned(request.auth.uid))
        // Ou n'importe qui peut s'ajouter/retirer des participants
        || (
          !isBanned(request.auth.uid)
          &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
        )
      );
      
      // Suppression : le créateur ou admin
      allow delete: if request.auth != null && (
        resource.data.ownerId == request.auth.uid
        || isAdmin(request.auth.uid)
      );
      
      // Règles pour les commentaires (sous-collection)
      match /comments/{commentId} {
        // Lecture : tout utilisateur authentifié
        allow read: if request.auth != null;
        
        // Création : tout utilisateur authentifié
        allow create: if request.auth != null
          && !isBanned(request.auth.uid)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.createdAt is timestamp;
        
        // Suppression : l'auteur ou admin
        allow delete: if request.auth != null && (
          resource.data.userId == request.auth.uid
          || isAdmin(request.auth.uid)
        );
        
        // Pas de mise à jour des commentaires
        allow update: if false;
      }
    }

    // regles pour les rapports/signalements
    match /reports/{reportId} {
      // lecture: seulement les admins
      allow read: if request.auth != null && isAdmin(request.auth.uid);
      
      // creation: tout utilisateur authentifie peut signaler
      allow create: if request.auth != null
        && !isBanned(request.auth.uid)
        && request.resource.data.activityId is string
        && request.resource.data.reason is string
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.reportedAt is timestamp;
      
      // pas de modification ni suppression
      allow update: if false;
      allow delete: if request.auth != null && isAdmin(request.auth.uid);
    }
  }
}

